meta {
  name: Resolve Dispute
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/admin/escrow/resolve
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
  Content-Type: application/json
}

body:json {
  {
    "order_id": "{{orderId}}",
    "resolution": "RELEASE",
    "admin_note": "Seller provided valid proof of delivery."
  }
}

docs {
  ## Admin — Resolve Dispute

  Admin resolves a disputed escrow (order in REVIEW status).

  ### Request Body
  | Field      | Type   | Required | Description                                    |
  |------------|--------|----------|------------------------------------------------|
  | order_id   | string | ✅       | Order UUID                                     |
  | resolution | string | ✅       | `RELEASE` (funds to seller) or `REFUND` (to buyer) |
  | admin_note | string | No       | Note (max. 2000 characters)                    |

  ### Headers
  | Header        | Value               | Required |
  |---------------|---------------------|----------|
  | Authorization | Bearer {{authToken}}| ✅       |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "message": "Dispute resolved: funds released to seller",
    "data": { ... }
  }
  ```

  ### Error Responses
  - **400** — Invalid input / Order not in REVIEW
  - **401** — Missing/invalid token
  - **403** — Forbidden (not admin)
}
