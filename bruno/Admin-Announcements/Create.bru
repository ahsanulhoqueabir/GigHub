meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/admin/announcements
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
  Content-Type: application/json
}

body:json {
  {
    "title": "New Semester Registration Open",
    "content": "Registration for the new semester is now open. Please visit the academic office for details.",
    "type": "info",
    "is_active": true
  }
}

docs {
  ## Admin — Create Announcement

  Admin only. Creates a new announcement.

  ### Request Body
  | Field     | Type    | Required | Description                        |
  |-----------|---------|----------|------------------------------------|
  | title     | string  | ✅       | Announcement title                 |
  | content   | string  | ✅       | Announcement content               |
  | type      | string  | No       | Type (default: "info")             |
  | is_active | boolean | No       | Active status (default: true)      |
  | starts_at | string  | No       | ISO-8601 start date                |
  | ends_at   | string  | No       | ISO-8601 end date                  |

  ### Headers
  | Header        | Value               | Required |
  |---------------|---------------------|----------|
  | Authorization | Bearer {{authToken}}| ✅       |

  ### Success Response (201)
  ```json
  {
    "success": true,
    "message": "Announcement created successfully",
    "data": { ... }
  }
  ```

  ### Error Responses
  - **400** — Validation error
  - **401** — Missing/invalid token
  - **403** — Forbidden (not admin)
}
