meta {
  name: Get By ID
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/admin/announcements/{{announcementId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  ## Admin — Get Announcement By ID

  Admin only. Returns a single announcement by ID.

  ### Variables
  | Variable        | Description        |
  |-----------------|--------------------|
  | announcementId  | Announcement UUID  |

  ### Headers
  | Header        | Value               | Required |
  |---------------|---------------------|----------|
  | Authorization | Bearer {{authToken}}| ✅       |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "data": { ... }
  }
  ```

  ### Error Responses
  - **400** — Announcement ID is required
  - **404** — Not found
  - **401** — Missing/invalid token
  - **403** — Forbidden (not admin)
}
