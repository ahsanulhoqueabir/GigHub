meta {
  name: Get Config
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/admin/system-config
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  ## Admin — Get System Config

  Admin only. Returns the current system configuration.

  ### Headers
  | Header        | Value               | Required |
  |---------------|---------------------|----------|
  | Authorization | Bearer {{authToken}}| ✅       |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "data": {
      "maintenance_mode": false,
      "registration_enabled": true,
      "platform_fee_percent": 5,
      "max_gig_images": 5,
      "max_portfolio_images": 10,
      "max_upload_size_mb": 10,
      "support_email": "support@gighub.com",
      "support_phone": "+8801700000000"
    }
  }
  ```

  ### Error Responses
  - **401** — Missing/invalid token
  - **403** — Forbidden (not admin)
}
