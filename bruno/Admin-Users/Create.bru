post {
  url: {{baseUrl}}/api/admin/users
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "name": "New User",
    "email": "newuser@example.com",
