meta {
  name: Update - Change Password
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/admin/users/USER_UUID
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "password": "newSecurePassword456"
  }
}

docs {
  ## Update User — Change Password

  Tests updating only the password. The password is hashed via argon2 before storing.
  Replace `USER_UUID` with the actual user ID.

  ### Expected Response (200)
  ```json
  {
    "success": true,
    "message": "User updated successfully",
    "data": { ... }
  }
  ```
}
