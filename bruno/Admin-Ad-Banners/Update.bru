meta {
  name: Update
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/admin/ad-banners/{{adBannerId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Updated Ad Name",
    "is_active": false,
    "sort_order": 3
  }
}

docs {
  ## Admin — Update Ad Banner

  Admin only. Updates an existing ad banner (all fields optional).

  ### Variables
  | Variable    | Description     |
  |-------------|-----------------|
  | adBannerId  | Ad banner UUID  |

  ### Headers
  | Header        | Value               | Required |
  |---------------|---------------------|----------|
  | Authorization | Bearer {{authToken}}| ✅       |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "message": "Ad banner updated successfully",
    "data": { ... }
  }
  ```

  ### Error Responses
  - **400** — Validation error
  - **401** — Missing/invalid token
  - **403** — Forbidden (not admin)
}
