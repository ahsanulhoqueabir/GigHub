meta {
  name: Delete
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/api/admin/ad-banners/{{adBannerId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  ## Admin — Delete Ad Banner

  Admin only. Deletes an ad banner by ID.

  ### Variables
  | Variable    | Description     |
  |-------------|-----------------|
  | adBannerId  | Ad banner UUID  |

  ### Headers
  | Header        | Value               | Required |
  |---------------|---------------------|----------|
  | Authorization | Bearer {{authToken}}| ✅       |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "message": "Ad banner deleted successfully",
    "data": { ... }
  }
  ```

  ### Error Responses
  - **400** — Cannot delete
  - **401** — Missing/invalid token
  - **403** — Forbidden (not admin)
}
