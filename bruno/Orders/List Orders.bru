meta {
  name: List Orders
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/orders
  body: none
  auth: inherit
}

docs {
  ### List Orders
  Lists all orders where the authenticated user is either the buyer or the seller.
  Returns structured response containing buyer, seller, gig, and job details.
  
  #### Headers
  - `Authorization: Bearer <token>` (Inherited)
  
  #### Response (200 OK)
  ```json
  {
    "success": true,
    "data": [
      {
        "id": "uuid-string",
        "status": "pending",
        "code": "G2606240030B",
        "total_price": 50,
        "title": "Build NestJS Backend",
        "source": "gig",
        "buyer": {
          "id": "uuid-string",
          "name": "Jane Doe",
          "username": "janedoe",
          "email": "jane@example.com",
          "avatar": "..."
        },
        "seller": {
          "id": "uuid-string",
          "name": "John Doe",
          "username": "johndoe",
          "email": "john@example.com",
          "avatar": "..."
        },
        "gig": {
          "id": "uuid-string",
          "title": "Build NestJS Backend",
          "slug": "..."
        },
        "job": null
      }
    ],
    "message": "Orders retrieved successfully"
  }
  ```
}
