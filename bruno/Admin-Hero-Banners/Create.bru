meta {
  name: Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/hero-banners
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
  Content-Type: application/json
}

body:json {
  {
    "title": "Welcome to Gighub",
    "subtitle": "Find amazing freelance services",
    "image_url": "https://example.com/banner.jpg",
    "alt_text": "Gighub Banner",
    "button_text": "Get Started",
    "button_url": "/signup",
    "sort_order": 1,
    "is_active": true
  }
}

docs {
  ## Admin — Create Hero Banner

  Admin only. Creates a new hero banner.

  ### Request Body
  | Field      | Type    | Required | Description                    |
  |------------|---------|----------|--------------------------------|
  | title      | string  | ✅       | Banner title                   |
  | subtitle   | string  | No       | Banner subtitle                |
  | image_url  | string  | ✅       | Banner image URL               |
  | alt_text   | string  | ✅       | Alt text for accessibility     |
  | button_text| string  | No       | CTA button text                |
  | button_url | string  | No       | CTA button link                |
  | sort_order | number  | No       | Display order (default: 0)     |
  | is_active  | boolean | No       | Active status (default: true)  |
  | starts_at  | string  | No       | ISO-8601 start date            |
  | ends_at    | string  | No       | ISO-8601 end date              |

  ### Headers
  | Header        | Value               | Required |
  |---------------|---------------------|----------|
  | Authorization | Bearer {{authToken}}| ✅       |

  ### Success Response (201)
  ```json
  {
    "success": true,
    "message": "Hero banner created successfully",
    "data": { ... }
  }
  ```

  ### Error Responses
  - **400** — Validation error
  - **401** — Missing/invalid token
  - **403** — Forbidden (not admin)
}
