meta {
  name: List Rooms
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/chat/rooms
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  ## List Chat Rooms

  Returns all chat rooms where the authenticated user is a participant.

  ### Headers
  | Header        | Value               | Required |
  |---------------|---------------------|----------|
  | Authorization | Bearer {{authToken}}| ✅       |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "data": [
      {
        "id": "uuid",
        "order_id": "uuid",
        "participants": ["uuid1", "uuid2"],
        "last_message": "...",
        "last_message_at": "2025-01-01T00:00:00Z",
        "created_at": "2025-01-01T00:00:00Z"
      }
    ]
  }
  ```

  ### Error Responses
  - **401** — Missing/invalid token
  - **500** — Server error
}
