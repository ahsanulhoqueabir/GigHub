meta {
  name: Get Presigned URL - Unauthorized
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/storage/presigned-url
  body: json
  auth: none
}

body:json {
  {
    "fileName": "my-avatar.png",
    "contentType": "image/png",
    "folder": "avatars"
  }
}

docs {
  ### Get Presigned R2 Upload URL - Unauthorized
  Verifies that access is blocked when no authentication token is provided in the headers.
  
  #### Response (401 Unauthorized)
  ```json
  {
    "success": false,
    "error": "Unauthorized",
    "details": "Access token is missing",
    "status": 401
  }
  ```
}
