meta {
  name: Change Password - Unauthorized
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "password123",
    "newPassword": "newPassword456",
    "confirmPassword": "newPassword456"
  }
}

docs {
  ## Change Password — Unauthorized

  Tests changing password without an auth token.

  ### Expected Error Response (401)
  ```json
  {
    "success": false,
    "error": "Authentication required"
  }
  ```
}
