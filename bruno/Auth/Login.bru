meta {
  name: Login
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "emailOrUsername": "abir@gighub.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.token) {
    bru.setVar("authToken", res.body.data.token);
  }
}

docs {
  ## Login — Authenticate with email
  
  Accepts either email or username in the `emailOrUsername` field.
  If the value contains `@`, it's treated as email; otherwise as username.
  
  ### Request Body
  | Field          | Type   | Required | Description                          |
  |----------------|--------|----------|--------------------------------------|
  | emailOrUsername| string | ✅       | Email (with @) or username           |
  | password       | string | ✅       | Account password                     |
  
  ### Success Response (200)
  ```json
  {
    "success": true,
    "message": "Login successful",
    "data": {
      "user": {
        "id": "uuid",
        "email": "abir@example.com",
        "name": "Abir Hasan",
        "username": "hasan-452187",
        "role": "USER",
        "student_id": "2023-123-456",
        "department": "uuid"
      },
      "token": "eyJhbGciOiJIUzI1NiJ9..."
    }
  }
  ```
  
  ### Error Responses
  - **401** — Invalid email/username or password
  - **400** — Missing fields
}
