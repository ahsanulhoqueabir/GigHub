meta {
  name: Google Auth - Requires Signup
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/google
  body: json
  auth: none
}

body:json {
  {
    "token": "valid-firebase-id-token-but-unregistered"
  }
}

docs {
  ### Google Authenticate - Requires Signup
  Verifies the Google/Firebase ID token successfully, but the user is not found in the database. Returns user info to help the frontend complete the signup.
  
  #### Response (404 Not Found)
  ```json
  {
    "statusCode": 404,
    "message": "Google account not registered. Please complete sign up.",
    "googleUid": "firebase-uid-value",
    "email": "jane-google@example.com",
    "name": "Jane Google",
    "requiresSignup": true
  }
  ```
}
