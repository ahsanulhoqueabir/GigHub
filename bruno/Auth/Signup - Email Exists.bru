meta {
  name: Signup - Email Exists
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "name": "Jane Doe",
    "email": "jane.doe@example.com",
    "phone": "01700000999",
    "department": "CSE",
