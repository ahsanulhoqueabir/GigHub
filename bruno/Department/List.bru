meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/department?page=1&limit=10
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 10
}

docs {
  ## List Departments — Public

  Returns a paginated list of ACTIVE departments only.

  ### Query Parameters
  | Parameter | Type    | Description                                      |
  |-----------|---------|--------------------------------------------------|
  | page      | number  | Page number (default: 1)                         |
  | limit     | number  | Items per page (default: 50, max: 1000)          |
  | sortBy    | string  | Sort field: `name`, `code`, `created_at`, `acronym` |
  | sortOrder | string  | `asc` or `desc`                                  |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "data": {
      "items": [...],
      "pagination": {
        "currentPage": 1,
        "pageSize": 10,
        "totalPages": 1,
        "total": 3,
        "hasNext": false,
        "hasPrev": false
      }
    }
  }
  ```
}
