meta {
  name: Admin - List All
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/admin/departments?page=1&limit=50
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

params:query {
  page: 1
  limit: 50
}

docs {
  ## List All Departments — Admin only

  Returns a paginated list of ALL departments (including DRAFT, ON_HOLD, etc.).
  By default excludes DELETED. Use `?includeDeleted=true` to include deleted ones.
  Use `?status=DRAFT` to filter by a specific status.

  ### Query Parameters
  | Parameter      | Type    | Description                                      |
  |----------------|---------|--------------------------------------------------|
  | page           | number  | Page number (default: 1)                         |
  | limit          | number  | Items per page (default: 50, max: 1000)          |
  | status         | string  | Filter by status: `ACTIVE`, `DRAFT`, `ON_HOLD`   |
  | includeDeleted | boolean | Set to `true` to include DELETED departments     |
  | sortBy         | string  | Sort field: `name`, `code`, `created_at`, `status` |
  | sortOrder      | string  | `asc` or `desc`                                  |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "data": {
      "items": [...],
      "pagination": { ... }
    }
  }
  ```
}
