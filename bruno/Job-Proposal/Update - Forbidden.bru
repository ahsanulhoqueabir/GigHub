body:json {
  {
    "description": "Trying to update someone else's proposal"
  }
}

docs {
  ## Update Job Proposal — Forbidden (Not Owner)

  Tests that updating another user's proposal without being the applicant or admin returns 403.
  Expected: 403 Forbidden.
  Replace `ANOTHER_USERS_PROPOSAL_UUID` with a proposal ID owned by a different user.
}
