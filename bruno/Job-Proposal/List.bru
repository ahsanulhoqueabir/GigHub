get {
  url: {{baseUrl}}/api/job-proposal
  body: none
  auth: none
}

docs {
  ## List Job Proposals — Public

  Returns a paginated list of job proposals with job and applicant profile data.

  ### Query Parameters
  | Parameter  | Type    | Description                                      |
  |-----------|---------|--------------------------------------------------|
  | page      | number  | Page number (default: 1)                         |
  | limit     | number  | Items per page (default: 50, max: 1000)          |
  | sortBy    | string  | Sort field: `created_at`, `updated_at`           |
  | sortOrder | string  | `asc` or `desc`                                  |
  | job       | string  | Filter by job UUID                               |
  | applicant | string  | Filter by applicant UUID                         |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "data": {
      "items": [
        {
          "id": "...",
          "description": "...",
          "attachments": [...],
          "status": "PENDING",
          "created_at": "...",
          "job": {
            "id": "...",
            "title": "...",
            "slug": "...",
            "status": "ACTIVE"
          },
          "applicant": {
            "id": "...",
            "name": "...",
            "username": "...",
            "avatar": null,
            "verified": false,
            "department": "..."
          }
        }
      ],
      "pagination": {
        "currentPage": 1,
        "pageSize": 50,
        "totalPages": 1,
        "total": 5,
        "hasNext": false,
        "hasPrev": false
      }
    }
  }
  ```
}
