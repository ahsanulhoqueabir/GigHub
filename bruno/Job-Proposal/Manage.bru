meta {
  name: Manage
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/job-proposal/manage
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  ## Manage Job Proposals — Protected (Authenticated User)

  Returns a paginated list of the caller's own proposals with job details.

  ### Query Parameters
  | Parameter  | Type    | Description                                      |
  |-----------|---------|--------------------------------------------------|
  | page      | number  | Page number (default: 1)                         |
  | limit     | number  | Items per page (default: 50, max: 1000)          |
  | sortBy    | string  | Sort field: `created_at`, `updated_at`           |
  | sortOrder | string  | `asc` or `desc`                                  |
  | job       | string  | Filter by job UUID                               |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "data": {
      "items": [
        {
          "id": "...",
          "description": "...",
          "attachments": [...],
          "status": "PENDING",
          "created_at": "...",
          "updated_at": "...",
          "job": {
            "id": "...",
            "title": "...",
            "slug": "...",
            "status": "ACTIVE",
            "budget": "$3000 - $5000",
            "type": "FULLTIME",
            "deadline": "2026-08-15T00:00:00Z"
          },
          "applicant": {
            "id": "...",
            "name": "...",
            "username": "...",
            "avatar": null,
            "verified": false,
            "department": "..."
          }
        }
      ],
      "pagination": {
        "page": 1,
        "limit": 50,
        "total": 5,
        "totalPages": 1
      }
    }
  }
  ```
}
