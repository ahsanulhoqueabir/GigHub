}

params:query {
  applicant: PROFILE_UUID
}

docs {
  ## List Job Proposals by Applicant — Public

  Filters job proposals by applicant UUID.
  Returns all proposals submitted by a specific user.
  Replace `PROFILE_UUID` with an actual profile ID.
}
