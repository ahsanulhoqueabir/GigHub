meta {
  name: Delete
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/api/gig/GIG_UUID
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  ## Delete Gig — Seller or Admin

  Safely deletes a gig. Only the seller or an admin can delete.
  Checks for active order references before deletion.
  Replace `GIG_UUID` with the actual gig ID.

  ### Success Response (200)
  ```json
  {
    "success": true,
    "message": "Gig deleted successfully",
    "data": { "deleted_id": "..." }
  }
  ```
}
