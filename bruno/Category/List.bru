  name: List
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/category?page=2&limit=5
  body: none
  auth: none
}

params:query {
  page: 2
  limit: 5
}

docs {
  ## List Categories — Public
  
  Returns a paginated list of active (non-deleted) categories.
  
  ### Query Parameters
  | Parameter | Type    | Description                                      |
  |-----------|---------|--------------------------------------------------|
  | page      | number  | Page number (default: 1)                         |
  | limit     | number  | Items per page (default: 50, max: 1000)          |
  | parent    | string  | Filter by parent UUID; use `null` for root only  |
  | sortBy    | string  | Sort field: `name`, `ordering`, `created_at`     |
  | sortOrder | string  | `asc` or `desc`                                  |
  
  ### Success Response (200)
  ```json
  {
    "success": true,
    "data": {
      "items": [...],
      "total": 10,
      "page": 1,
      "limit": 50
    }
  }
  ```
}
