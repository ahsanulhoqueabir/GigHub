meta {
  name: Create Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Design & Creative",
    "description": "Graphic design, illustration, and creative services",
    "slug": "design-creative",
    "image": "https://cdn.gighub.ahsanull.com/categories/design.png",
    "parent_id": null,
    "ordering": 1,
    "active": true
  }
}

docs {
  ### Create Category
  Creates a new category or sub-category. Only accessible to Admins and Moderators.
  
  #### Headers
  - `Authorization: Bearer <token>` (Inherited)
  
  #### Request Body
  - `name` (string, required)
  - `slug` (string, required, unique)
  - `description` (string, optional)
  - `image` (string, optional URL)
  - `parent_id` (UUID, optional)
  - `ordering` (integer, optional)
  - `active` (boolean, optional)
  
  #### Response (201 Created)
  ```json
  {
    "success": true,
    "data": {
      "id": "uuid-string",
      "name": "Design & Creative",
      "description": "Graphic design, illustration, and creative services",
      "slug": "design-creative",
      "image": "https://cdn.gighub.ahsanull.com/categories/design.png",
      "parent_id": null,
      "ordering": 1,
      "active": true,
      "created_at": "2026-06-24T00:30:00Z",
      "updated_at": "2026-06-24T00:30:00Z"
    },
    "message": "Category created successfully"
  }
  ```
}
