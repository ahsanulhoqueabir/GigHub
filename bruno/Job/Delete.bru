meta {
  name: Delete
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/api/job/JOB_UUID
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  ## Delete Job — Owner or Admin

  Safely deletes a job. Only the owner or an admin can delete.
  Checks for active order references before deletion.
  Replace `JOB_UUID` with the actual job ID.

  ### Success Response (200)
  ```json
  {
    "success": true,
    "message": "Job deleted successfully",
    "data": { "deleted_id": "..." }
  }
  ```
}
