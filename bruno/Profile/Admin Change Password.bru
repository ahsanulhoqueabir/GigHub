meta {
  name: Admin Change Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admin/users/:userId/change-password
  body: json
  auth: inherit
}

params:path {
  userId: <target-user-uuid>
}

body:json {
  {
    "password": "newadminpresetpassword123"
  }
}

docs {
  ### Admin Change Password
  Allows an administrator to reset/change the password of any user directly.
  
  #### Headers
  - `Authorization: Bearer <token>` (Must belong to an admin user)
  
  #### Path Parameters
  - `userId` (string, required): The UUID of the user to update.
  
  #### Request Body
  - `password` (string, required): The new password.
  
  #### Response (200 OK)
  Returns a success confirmation.
}
