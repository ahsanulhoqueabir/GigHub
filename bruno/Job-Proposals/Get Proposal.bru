meta {
  name: Get Proposal
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/job-proposals/:id
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

docs {
  ### Get Proposal
  Retrieves a single job proposal by ID.
  Only accessible to the applicant who submitted the proposal or the owner of the job post.
  
  #### Headers
  - `Authorization: Bearer <token>` (Inherited)
  
  #### Response (200 OK)
  ```json
  {
    "success": true,
    "data": {
      "id": "uuid-string",
      "status": "active",
      "job": "uuid-string",
      "applicant": "uuid-string",
      "description": "...",
      "applicant": {
        "id": "uuid-string",
        "name": "Jane Doe",
        "username": "janedoe",
        "email": "jane@example.com",
        "avatar": "https://cdn.gighub.ahsanull.com/avatars/jane.png"
      },
      "job": {
        "id": "uuid-string",
        "owner": "uuid-string",
        "title": "Need NestJS Expert",
        "status": "active"
      }
    },
    "message": "Job proposal retrieved successfully"
  }
  ```
}
