meta {
  name: List
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/order
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  ## List Orders — Participant or Admin

  Returns a paginated list of orders visible to the caller (via RLS).

  ### Query Parameters
  | Parameter  | Type    | Description                                      |
  |-----------|---------|--------------------------------------------------|
  | page      | number  | Page number (default: 1)                         |
  | limit     | number  | Items per page (default: 50, max: 1000)          |
  | sortBy    | string  | Sort field: `created_at`, `updated_at`, `total_price`, `status` |
  | sortOrder | string  | `asc` or `desc`                                  |
  | status    | string  | Filter by status (PENDING, ACTIVE, CANCELLED)    |
  | source    | string  | Filter by source (GIG, JOB)                      |
  | buyer     | string  | Filter by buyer UUID                             |
  | seller    | string  | Filter by seller UUID                            |
  | search    | string  | Search in order code or title                    |

  ### Success Response (200)
  ```json
  {
    "success": true,
    "data": {
      "items": [...],
      "pagination": {
        "currentPage": 1,
        "pageSize": 20,
        "totalPages": 1,
        "total": 5,
        "hasNext": false,
        "hasPrev": false
      }
    }
  }
  ```
}
