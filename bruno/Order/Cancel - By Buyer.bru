meta {
  name: Cancel - By Buyer
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/api/order/ORDER_UUID/cancel
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "reason": "No longer need this service"
  }
}

docs {
  ## Cancel Order — By Buyer

  Buyer cancels a PENDING or ACTIVE order.
  Replace `ORDER_UUID` with an order where the caller is the buyer.

  ### Success Response (200)
  ```json
  {
    "success": true,
    "message": "Order cancelled successfully",
    "data": { "order_id": "..." }
  }
  ```
}
