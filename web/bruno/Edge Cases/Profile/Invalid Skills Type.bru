meta {
  name: Invalid Skills Type
  type: http
  seq: 1
}

patch {
  url: {{base_url}}/profiles/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "skills": "not-an-array"
  }
}

docs {
  ## Response

  ```json
  {
    "success": false,
    "error": "Bad Request",
    "details": [
      {
        "property": "skills",
        "constraints": {
          "isArray": "skills must be an array"
        }
      }
    ],
    "status": 400
  }
  ```
}
