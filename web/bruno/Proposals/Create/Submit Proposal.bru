  {
    "success": true,
    "data": {
      "id": "uuid",
      "job": { "id": "uuid", "title": "Need a React Developer...", "slug": "need-a-react-developer..." },
      "applicant": { "id": "uuid", "display_name": "John", "username": "john_doe" },
      "cover_letter": "I am interested in this job and have 5 years of experience in React.",
      "quoted_price": 200,
      "estimated_days": 5,
      "status": "pending",
      "created_at": "2026-05-08T10:00:00.000Z",
      "updated_at": "2026-05-08T10:00:00.000Z"
    }
