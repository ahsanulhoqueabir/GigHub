meta {
  name: Submit Proposal
  type: http
  seq: 1
}

post {
  url: {{base_url}}/proposals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "job_id": "PASTE_JOB_ID_HERE",
    "cover_letter": "I am interested in this job and have 5 years of experience in React.",
    "quoted_price": 200,
    "estimated_days": 5
  }
}

docs {
  ## Response

