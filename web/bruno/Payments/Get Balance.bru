meta {
  name: Get Balance
  type: http
  seq: 2
}

get {
  url: {{base_url}}/payments?type=balance
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  ## Response

  ```json
  {
    "success": true,
    "data": {
      "balance": 5000,
      "currency": "BDT"
    }
  }
  ```
}
