meta {
  name: Weak Password
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/signup
  body: multipartForm
  auth: none
}

body:multipart-form {
  email: weak@example.com
  password: 123
  name: Weak User
  username: weak_user
}

docs {
  ## Payload
  - Content-Type: `multipart/form-data`
  - Required fields: `email`, `password`, `name`

  ## Error Response (400)

  ```json
  {
    "success": false,
    "error": "Password should be at least 6 characters."
  }
  ```
}
