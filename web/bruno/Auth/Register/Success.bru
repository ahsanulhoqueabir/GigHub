meta {
  name: Success
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/signup
  body: multipartForm
  auth: none
}

body:multipart-form {
  email: test_{{$randomInt}}@gighub.com
  password: Password123!
  name: Test User
  username: user_{{$randomInt}}
  bio: Full-stack freelancer
  skills: ["Next.js","TypeScript"]
}

docs {
  ## Payload
  - Content-Type: `multipart/form-data`
  - Required fields: `email`, `password`, `name`
  - Optional fields: `username`, `bio`, `skills` (JSON string array), `avatar` (file)

  ## Success Response (201)
  
  ```json
  {
    "success": true,
    "message": "User created successfully",
    "data": {
      "user": {
        "id": "profile-id",
        "email": "test_123@gighub.com",
        "name": "Test User"
      },
      "access_token": "eyJhbGciOiJIUzI1NiIs...",
      "refresh_token": "eyJhbGciOiJIUzI1NiIs...",
      "expires_in": "15m"
    }
  }
  ```
}
