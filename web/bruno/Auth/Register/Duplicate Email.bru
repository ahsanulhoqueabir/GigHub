meta {
  name: Duplicate Email
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/signup
  body: multipartForm
  auth: none
}

body:multipart-form {
  email: test@example.com
  password: Password123!
  name: Test User
  username: newuser_01
}

docs {
  ## Payload
  - Content-Type: `multipart/form-data`
  - Required fields: `email`, `password`, `name`

  ## Error Response (400)

  ```json
  {
    "success": false,
    "error": "User already registered"
  }
  ```
}
