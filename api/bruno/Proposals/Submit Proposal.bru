meta {
  name: Submit Proposal
  type: http
  seq: 1
}

post {
  url: {{base_url}}/proposals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "job_id": "paste-job-uuid-here",
    "cover_letter": "I have extensive experience with NestJS...",
    "bid_amount": 180,
    "estimated_days": 5
  }
}
