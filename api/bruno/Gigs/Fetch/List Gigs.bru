meta {
  name: List Gigs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/gigs?page=1&limit=10&sort=price_asc
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 10
  sort: price_asc
  ~search: abir
  ~category: 
  ~min_rating: 4
  ~tags: 
  ~min_price: 50
  ~max_price: 500
  ~max_delivery: 7
}

