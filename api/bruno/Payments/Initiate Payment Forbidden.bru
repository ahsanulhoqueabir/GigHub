meta {
  name: Initiate Payment Forbidden
  type: http
  seq: 10
}

post {
  url: {{base_url}}/payments/initiate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "order_id": "{{order_id}}"
  }
}

docs {
  ## Response

  ```json
  {
    "success": false,
    "error": "Forbidden",
    "details": "You are not allowed to initiate payment for this order",
    "status": 403
  }
  ```
}
