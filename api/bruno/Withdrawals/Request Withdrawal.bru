meta {
  name: Request Withdrawal
  type: http
  seq: 1
}

post {
  url: {{base_url}}/withdrawals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "amount": 100,
    "method": "bkash",
    "account_info": "017xxxxxxxx"
  }
}

docs {
  ## Response

  ```json
  {
    "success": true,
    "data": {
      "id": "uuid",
      "profile": { "id": "uuid", "display_name": "John", "username": "john_doe" },
      "amount": 100,
      "method": "bkash",
      "account_details": { "account_info": "017xxxxxxxx" },
      "status": "pending",
      "created_at": "2026-05-08T10:00:00.000Z",
      "updated_at": "2026-05-08T10:00:00.000Z"
    }
  }
  ```
}
