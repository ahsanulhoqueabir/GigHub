meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refreshtoken}}"
  }
}

docs {
  ## Response

  ```json
  {
    "success": true,
    "data": {
      "access_token": "eyJhbGciOiJIUzI1NiIs...",
      "refresh_token": "eyJhbGciOiJIUzI1NiIs...",
      "expires_in": "15m"
    }
  }
  ```
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("access_token", res.body.data.access_token);
  }
}
