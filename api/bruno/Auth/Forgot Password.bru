meta {
  name: Forgot Password
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "user@example.com"
  }
}

docs {
  ## Response

  ```json
  {
    "success": true,
    "message": "If that email exists, a reset link has been sent"
  }
  ```
}
