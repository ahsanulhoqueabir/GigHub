meta {
  name: Weak Password
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "weak@example.com",
    "password": "123",
    "display_name": "Weak User",
    "username": "weak_user"
  }
}

docs {
  ## Response

  ```json
  {
    "success": false,
    "error": "Bad Request",
    "details": [
      {
        "property": "password",
        "constraints": {
          "minLength": "Password must be at least 8 characters"
        }
      }
    ],
    "status": 400
  }
  ```
}
