meta {
  name: List My Orders
  type: http
  seq: 2
}

get {
  url: {{base_url}}/orders/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

params:query {
  page: 1
  limit: 20
}

