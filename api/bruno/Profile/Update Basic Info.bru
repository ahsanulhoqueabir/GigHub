      "username": "john_doe",
      "email": "john@example.com",
      "avatar": null,
      "bio": "New bio content...",
      "skills": ["Node.js", "NestJS", "Bruno"],
      "availability_status": "available",
      "is_verified": false,
      "role": "student",
