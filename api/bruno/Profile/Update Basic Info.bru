meta {
  name: Update Basic Info
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/profiles/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "type": "basic_info",
    "display_name": "Updated Name",
    "bio": "New bio content...",
    "skills": ["Node.js", "NestJS", "Bruno"]
  }
}

docs {
  ## Response

