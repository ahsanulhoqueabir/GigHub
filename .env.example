# Environment Variables for the GigHub mobile app
# All values here are embedded in the client bundle — public/anon values only.

# Override the backend API base URL (defaults to https://gighub.ahsanull.com/api)
EXPO_PUBLIC_API_URL=https://gighub.ahsanull.com/api

# Supabase Realtime (chat) — public URL + anon/publishable key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISH_KEY=your_supabase_publishable_key
